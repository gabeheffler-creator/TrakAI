{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node ./src/migrate.mjs",
    "push:dev": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force:dev": "drizzle-kit push --force --config ./drizzle.config.ts",
    "push": "echo 'DEV ONLY: shared/production databases use committed migrations or Replit Publish.' && pnpm run push:dev",
    "push-force": "echo 'DEV ONLY: never run this against a shared/production database.' && pnpm run push-force:dev"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
